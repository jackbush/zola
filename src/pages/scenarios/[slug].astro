---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import shuffle from '@phosphor-icons/core/assets/bold/shuffle-bold.svg?raw';

export async function getStaticPaths() {
  const scenarios = await getCollection('scenarios');
  return scenarios.map((scenario) => ({
    params: { slug: scenario.slug },
    props: { scenario },
  }));
}

const { scenario } = Astro.props;
const { Content } = await scenario.render();

const allScenarios = await getCollection('scenarios');
const slugs = allScenarios.map((s) => s.slug);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title={scenario.data.title}>
  <header class="header header--plain">
    {/* The site name is the same on every scenario, so the scenario is the h1 */}
    <p class="header__title">Inclusive Design Scenarios</p>
  </header>

  <article aria-labelledby="scenario-title">
    <h1 class="eyebrow eyebrow--highlight" id="scenario-title">{scenario.data.title}</h1>
    <Content />
  </article>

  <div class="cta__wrapper">
    <button class="cta" id="random-btn" type="button"><Icon svg={shuffle} class="cta__icon" />Show another scenario</button>
  </div>
</Layout>

<script define:vars={{ slugs, base, currentSlug: scenario.slug }}>
  document.getElementById('random-btn').addEventListener('click', () => {
    const others = slugs.filter((s) => s !== currentSlug);
    const next = others[Math.floor(Math.random() * others.length)];
    window.location.href = base + 'scenarios/' + next;
  });
</script>

<style>
  article :global(p) {
    font-size: clamp(1.375rem, 3.5vw, 2rem);
    line-height: 1.55;
    font-weight: 400;
    margin: 0;
    letter-spacing: -0.01em;
  }
</style>
